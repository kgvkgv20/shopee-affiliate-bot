# ==========================================
# Shopee Affiliate Bot — Environment Config
# ==========================================

# 1. Gemini API Key (ฟรี จาก Google AI Studio)
# รับคีย์ได้ที่: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# 2. Telegram Bot (ทางเลือก: ส่งวิดีโอเข้า Telegram มือถือ)
# รับ Token จาก @BotFather และ Chat ID จาก @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. LINE Messaging API (ทางเลือก: ส่งแจ้งเตือน + แคปชัน + ปุ่มเปิด Shopee เข้า LINE)
# สมัครที่ developers.line.biz (Messaging API)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# 4. Discord Webhook (ทางเลือก: ง่ายที่สุด ไม่ต้องสร้างบอท แค่ก๊อปปี้ Webhook URL จากห้องแชท)
DISCORD_WEBHOOK_URL=

# 5. Shopee Affiliate Open API (ถ้ามี ไม่จำเป็นต้องใส่)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# 5. การตั้งค่าทั่วไป
CONTENT_LANGUAGE=th
TARGET_CATEGORIES=beauty,home,electronics,fashion
PRODUCTS_PER_DAY=2
