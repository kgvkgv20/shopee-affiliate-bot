# ==========================================
# Shopee Affiliate Bot — Environment Config
# ==========================================

# 1. Gemini API Key (ฟรี จาก Google AI Studio)
# รับคีย์ได้ที่: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# 2. Telegram Bot (ถ้าต้องการให้ส่งเข้ามือถืออัตโนมัติ)
# รับ Token จาก @BotFather และ Chat ID จาก @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Shopee Affiliate Open API (ถ้ามี ไม่จำเป็นต้องใส่)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# 4. การตั้งค่าทั่วไป
CONTENT_LANGUAGE=th
TARGET_CATEGORIES=beauty,home,electronics,fashion
PRODUCTS_PER_DAY=2
